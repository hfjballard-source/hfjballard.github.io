SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
GOOGLE_SERVICE_ACCOUNT_EMAIL=REPLACE_ME@YOUR-PROJECT.iam.gserviceaccount.com
